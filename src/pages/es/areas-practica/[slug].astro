---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AreaDetail from '../../../components/areas/AreaDetail.astro';
import { t } from '../../../i18n/utils';

const lang = 'es' as const;

export async function getStaticPaths() {
  return ['laboral', 'civil', 'penal', 'familia', 'corporativo', 'contratos']
    .map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;

const icons: Record<string, string> = {
  laboral: `<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>`,
  civil: `<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>`,
  penal: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
  familia: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  corporativo: `<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>`,
  contratos: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/>`,
};

const faqsBySlug: Record<string, Array<{ pregunta: string; respuesta: string }>> = {
  laboral: [
    { pregunta: '¿Cuándo debo consultar a un abogado laboral?', respuesta: 'Si enfrenta un despido, acoso laboral, multas o conflictos con su empleador, consulte a la brevedad. Actuar a tiempo puede ser determinante para el resultado de su caso.' },
    { pregunta: '¿Cuánto cuesta la primera consulta?', respuesta: 'La primera consulta es gratuita y sin compromiso. En ella evaluamos su situación y le explicamos las opciones disponibles.' },
    { pregunta: '¿Atienden casos fuera de Rancagua?', respuesta: 'Atendemos en toda la Región de O\'Higgins y, según la complejidad del caso, en otras regiones del país.' },
  ],
  civil: [
    { pregunta: '¿Qué tipo de contratos revisan?', respuesta: 'Revisamos todo tipo de contratos: compraventa de inmuebles, arrendamiento, préstamos, prestación de servicios y contratos comerciales complejos.' },
    { pregunta: '¿Puedo demandar por daños y perjuicios?', respuesta: 'Sí. Evaluamos la viabilidad de una acción civil por daños patrimoniales o morales y le acompañamos en todo el proceso judicial.' },
    { pregunta: '¿Asesoran en herencias y sucesiones?', respuesta: 'Sí. Gestionamos sucesiones, particiones de bienes y todos los trámites asociados a herencias en Chile.' },
  ],
  penal: [
    { pregunta: '¿Qué hago si me imputan de un delito?', respuesta: 'Contacte a un abogado penalista de inmediato. Tiene derecho a defensa desde el primer momento y no está obligado a declarar sin asistencia letrada.' },
    { pregunta: '¿Cubren todo el proceso penal?', respuesta: 'Sí, desde la formalización y la etapa de investigación hasta el juicio oral, recursos de apelación y nulidad.' },
    { pregunta: '¿Tienen experiencia en casos complejos?', respuesta: 'Contamos con amplia trayectoria en el sistema de justicia penal chileno, incluyendo casos de alta complejidad y delitos económicos.' },
  ],
  familia: [
    { pregunta: '¿Cómo funciona el divorcio en Chile?', respuesta: 'Existe el divorcio de mutuo acuerdo, más rápido, y el divorcio por cese de convivencia. Le orientamos sobre la vía más adecuada según su situación.' },
    { pregunta: '¿Pueden ayudarme con la pensión de alimentos?', respuesta: 'Sí. Asesoramos para fijar, aumentar o reducir la pensión alimenticia según la situación socioeconómica de las partes y el interés superior del menor.' },
    { pregunta: '¿Qué es la tuición compartida?', respuesta: 'Es el cuidado alternado del hijo entre ambos padres. Evaluamos la viabilidad jurídica y los acuerdos más convenientes para el bienestar del menor.' },
  ],
  corporativo: [
    { pregunta: '¿Cuánto tarda constituir una empresa en Chile?', respuesta: 'Una SpA puede constituirse en un día hábil mediante escritura simplificada. Otros tipos societarios pueden tomar entre 3 y 7 días hábiles.' },
    { pregunta: '¿Qué tipos de sociedades asesoran?', respuesta: 'Asesoramos en SpA, SRL, SA y cualquier otra forma societaria, así como en reorganizaciones, fusiones y adquisiciones.' },
    { pregunta: '¿Ayudan con cumplimiento normativo?', respuesta: 'Sí. Prestamos asesoría continua en normativa laboral, tributaria, ambiental y sectorial según la industria de su empresa.' },
  ],
  contratos: [
    { pregunta: '¿Por qué revisar un contrato antes de firmarlo?', respuesta: 'Un contrato mal redactado puede generar obligaciones desproporcionadas, litigios costosos y pérdidas patrimoniales. La revisión previa es siempre una inversión.' },
    { pregunta: '¿Pueden negociar en mi nombre?', respuesta: 'Sí. Representamos a nuestros clientes en la negociación directa con contrapartes, buscando las condiciones más favorables para sus intereses.' },
    { pregunta: '¿Cuánto tardan en revisar un contrato?', respuesta: 'Dependiendo de la extensión y complejidad, entre 2 y 5 días hábiles. Para contratos urgentes ofrecemos revisión prioritaria.' },
  ],
};

const areaTitle = t(lang, `areas.${slug}.title`);
const faqs = faqsBySlug[slug] ?? [];
const icon = icons[slug] ?? '';
---

<BaseLayout
  title={`${areaTitle} | Guíñez Galaz Abogados`}
  description={t(lang, `areas.${slug}.desc`)}
  lang={lang}
>
  <AreaDetail lang={lang} areaKey={slug} areaSlug={slug} faqs={faqs} icon={icon} />
</BaseLayout>
