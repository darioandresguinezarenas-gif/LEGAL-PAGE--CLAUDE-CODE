---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Abogados | Admin" pageTitle="Abogados">

  <div class="card">
    <div class="card-header">
      <span class="card-title">Perfiles de abogados</span>
      <div class="topbar-actions">
        <button class="btn btn-gold" id="btn-new">+ Nuevo abogado</button>
      </div>
    </div>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr><th>Nombre</th><th>Cargo (ES)</th><th>Años</th><th>Orden</th><th>Estado</th><th>Acciones</th></tr>
        </thead>
        <tbody id="table-body">
          <tr><td colspan="6" class="loading-box"><div class="spinner"></div></td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal -->
  <div class="modal-overlay" id="modal-abogado">
    <div class="modal modal-lg">
      <div class="modal-header">
        <h2 class="modal-title" id="modal-title">Nuevo abogado</h2>
        <button class="modal-close" id="modal-close">×</button>
      </div>
      <div class="modal-body">
        <form id="form-abogado">
          <input type="hidden" name="id" />
          <div class="form-row">
            <div class="form-group">
              <label class="form-label req">Nombre completo</label>
              <input name="nombre" class="form-input" required />
            </div>
            <div class="form-group">
              <label class="form-label req">Slug</label>
              <input name="slug" class="form-input font-mono" required placeholder="ej: gonzalo-guinez" />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Cargo</label>
            <div class="lang-tabs" data-group="cargo">
              <button type="button" class="lang-tab active" data-lang="es">ES</button>
              <button type="button" class="lang-tab" data-lang="en">EN</button>
              <button type="button" class="lang-tab" data-lang="zh">中文</button>
            </div>
            <div class="lang-panel active" data-group="cargo" data-lang="es"><input name="cargo_es" class="form-input" placeholder="Socio" /></div>
            <div class="lang-panel"        data-group="cargo" data-lang="en"><input name="cargo_en" class="form-input" placeholder="Partner" /></div>
            <div class="lang-panel"        data-group="cargo" data-lang="zh"><input name="cargo_zh" class="form-input" placeholder="合伙人" /></div>
          </div>

          <div class="form-group">
            <label class="form-label">Biografía</label>
            <div class="lang-tabs" data-group="bio">
              <button type="button" class="lang-tab active" data-lang="es">ES</button>
              <button type="button" class="lang-tab" data-lang="en">EN</button>
              <button type="button" class="lang-tab" data-lang="zh">中文</button>
            </div>
            <div class="lang-panel active" data-group="bio" data-lang="es"><textarea name="bio_es" class="form-textarea tall" placeholder="Biografía en español…"></textarea></div>
            <div class="lang-panel"        data-group="bio" data-lang="en"><textarea name="bio_en" class="form-textarea tall" placeholder="Biography in English…"></textarea></div>
            <div class="lang-panel"        data-group="bio" data-lang="zh"><textarea name="bio_zh" class="form-textarea tall" placeholder="中文简介…"></textarea></div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Foto</label>
              <div class="upload-widget" id="upload-foto">
                <input type="hidden" name="foto_url" class="upload-hidden" />
                <input type="file" accept=".jpg,.jpeg,.png,.webp" class="upload-file-input" tabindex="-1" />
                <div class="upload-preview">
                  <img class="upload-preview-img" src="" alt="" />
                  <button type="button" class="btn btn-danger btn-xs upload-remove">× Quitar</button>
                </div>
                <button type="button" class="btn btn-outline btn-sm upload-trigger">↑ Subir foto</button>
                <p class="form-hint">JPG, PNG o WEBP · máx. 5 MB</p>
                <span class="upload-status">Subiendo…</span>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Años de trayectoria</label>
              <input name="anos_trayectoria" type="number" min="0" class="form-input" value="0" />
            </div>
          </div>

          <div class="form-row-3">
            <div class="form-group">
              <label class="form-label">Email</label>
              <input name="email" type="email" class="form-input" />
            </div>
            <div class="form-group">
              <label class="form-label">Teléfono</label>
              <input name="telefono" class="form-input" placeholder="+56 9 XXXX XXXX" />
            </div>
            <div class="form-group">
              <label class="form-label">LinkedIn URL</label>
              <input name="linkedin_url" type="url" class="form-input" placeholder="https://linkedin.com/in/…" />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Formación académica</label>
            <div class="tag-input-row">
              <input id="inp-formacion" class="form-input" placeholder="Ej: Abogado, U. de Chile — Enter para agregar" />
            </div>
            <div class="tags-list" id="list-formacion"></div>
          </div>

          <div class="form-group">
            <label class="form-label">Especialidades</label>
            <div class="tag-input-row">
              <input id="inp-espec" class="form-input" placeholder="Ej: Derecho Laboral — Enter para agregar" />
            </div>
            <div class="tags-list" id="list-espec"></div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Orden</label>
              <input name="orden" type="number" class="form-input" value="0" min="0" />
            </div>
            <div class="form-group" style="display:flex;align-items:flex-end;padding-bottom:0.2rem">
              <label class="form-check">
                <input type="checkbox" name="activo" checked />
                Perfil activo (visible en el sitio)
              </label>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button class="btn btn-outline" id="btn-cancel">Cancelar</button>
        <button class="btn btn-primary" id="btn-save">Guardar</button>
      </div>
    </div>
  </div>

</AdminLayout>

<script>
  import { supabase, requireAuth } from '../../scripts/admin/client.js';
  import { showToast, showModal, hideModal, initLangTabs, getLang, setLang, initTagInput } from '../../scripts/admin/ui.js';
  import { initUploadWidget } from '../../scripts/admin/storage.js';

  let records = [];
  let editingId = null;
  let getFormacion, getEspec;

  const form  = document.getElementById('form-abogado');
  const tbody = document.getElementById('table-body');
  const fotoWidget = initUploadWidget('upload-foto', 'abogados');

  (async () => {
    const session = await requireAuth();
    if (!session) return;
    initTagInputs([],[]);
    await loadRecords();
  })();

  function initTagInputs(formacion, espec) {
    getFormacion = initTagInput(
      document.getElementById('inp-formacion'),
      document.getElementById('list-formacion'),
      formacion
    );
    getEspec = initTagInput(
      document.getElementById('inp-espec'),
      document.getElementById('list-espec'),
      espec
    );
  }

  async function loadRecords() {
    const { data, error } = await supabase
      .from('abogados').select('*').is('deleted_at', null).order('orden');
    if (error) { showToast(error.message, 'error'); return; }
    records = data ?? [];
    renderTable();
  }

  function renderTable() {
    if (!records.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="empty-box">Sin abogados registrados.</td></tr>';
      return;
    }
    tbody.innerHTML = records.map(r => `
      <tr>
        <td>
          ${r.foto_url ? `<img src="${r.foto_url}" class="img-thumb" style="margin-right:8px;vertical-align:middle" onerror="this.style.display='none'" />` : ''}
          ${r.nombre}
        </td>
        <td class="text-muted">${r.cargo?.es ?? '—'}</td>
        <td class="text-muted">${r.anos_trayectoria}</td>
        <td class="text-muted">${r.orden}</td>
        <td>${r.activo ? '<span class="badge badge-active">Activo</span>' : '<span class="badge badge-inactive">Inactivo</span>'}</td>
        <td class="td-actions">
          <button class="btn btn-outline btn-xs" data-action="edit"   data-id="${r.id}">Editar</button>
          <button class="btn btn-danger  btn-xs" data-action="delete" data-id="${r.id}">Eliminar</button>
        </td>
      </tr>`).join('');
  }

  tbody.addEventListener('click', e => {
    const btn = e.target.closest('[data-action]');
    if (!btn) return;
    if (btn.dataset.action === 'edit')   openEdit(btn.dataset.id);
    if (btn.dataset.action === 'delete') doDelete(btn.dataset.id);
  });

  document.getElementById('btn-new').addEventListener('click', () => {
    editingId = null; form.reset(); form.id.value = '';
    form.activo.checked = true; form.anos_trayectoria.value = 0;
    fotoWidget.reset();
    initTagInputs([], []);
    document.getElementById('modal-title').textContent = 'Nuevo abogado';
    initLangTabs(form);
    showModal('modal-abogado');
  });

  function openEdit(id) {
    const r = records.find(x => x.id === id); if (!r) return;
    editingId = id; form.id.value = id;
    form.nombre.value = r.nombre; form.slug.value = r.slug;
    fotoWidget.setValue(r.foto_url ?? '');
    form.anos_trayectoria.value = r.anos_trayectoria;
    form.email.value = r.email ?? '';
    form.telefono.value = r.telefono ?? '';
    form.linkedin_url.value = r.linkedin_url ?? '';
    form.orden.value = r.orden; form.activo.checked = r.activo;
    setLang(form, 'cargo', r.cargo);
    setLang(form, 'bio', r.bio);
    initTagInputs(r.formacion ?? [], r.especialidades ?? []);
    document.getElementById('modal-title').textContent = 'Editar abogado';
    initLangTabs(form);
    showModal('modal-abogado');
  }

  document.getElementById('btn-save').addEventListener('click', async () => {
    const btn = document.getElementById('btn-save');
    btn.disabled = true; btn.textContent = 'Guardando…';

    const payload = {
      nombre: form.nombre.value.trim(),
      slug:   form.slug.value.trim(),
      foto_url: form.foto_url.value.trim() || null,
      anos_trayectoria: Number(form.anos_trayectoria.value),
      email: form.email.value.trim() || null,
      telefono: form.telefono.value.trim() || null,
      linkedin_url: form.linkedin_url.value.trim() || null,
      orden: Number(form.orden.value),
      activo: form.activo.checked,
      cargo: getLang(form, 'cargo'),
      bio:   getLang(form, 'bio'),
      formacion:     getFormacion(),
      especialidades: getEspec(),
    };

    let error;
    if (editingId) {
      ({ error } = await supabase.from('abogados').update(payload).eq('id', editingId));
    } else {
      ({ error } = await supabase.from('abogados').insert(payload));
    }
    btn.disabled = false; btn.textContent = 'Guardar';
    if (error) { showToast(error.message, 'error'); return; }
    showToast(editingId ? 'Abogado actualizado' : 'Abogado creado');
    hideModal('modal-abogado');
    await loadRecords();
  });

  async function doDelete(id) {
    if (!confirm('¿Eliminar este perfil?')) return;
    const { error } = await supabase.from('abogados').update({ deleted_at: new Date().toISOString() }).eq('id', id);
    if (error) { showToast(error.message, 'error'); return; }
    showToast('Perfil eliminado');
    await loadRecords();
  }

  document.getElementById('modal-close').addEventListener('click', () => hideModal('modal-abogado'));
  document.getElementById('btn-cancel').addEventListener('click', () => hideModal('modal-abogado'));
</script>
