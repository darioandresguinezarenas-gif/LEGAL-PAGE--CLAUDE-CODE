---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Acceso | Admin Guíñez Galaz" requireAuth={false}>
  <div class="login-page">
    <div class="login-card">
      <div class="login-logo">Guíñez Galaz</div>
      <div class="login-sub">Panel Administrativo</div>

      <!-- Step 1: email + password -->
      <div id="step-password">
        <p class="login-title">Iniciar sesión</p>
        <div class="login-error" id="err-password"></div>
        <form id="form-password">
          <div class="form-group">
            <label class="form-label req" for="inp-email">Correo electrónico</label>
            <input id="inp-email" name="email" type="email" class="form-input" required autocomplete="email" />
          </div>
          <div class="form-group">
            <label class="form-label req" for="inp-password">Contraseña</label>
            <input id="inp-password" name="password" type="password" class="form-input" required autocomplete="current-password" />
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:0.5rem" id="btn-login">
            Ingresar
          </button>
        </form>
      </div>

      <!-- Step 2: TOTP -->
      <div id="step-totp" style="display:none">
        <p class="login-title">Verificación MFA</p>
        <p class="text-sm text-muted" style="margin-bottom:1.25rem">Ingrese el código de 6 dígitos de su aplicación autenticadora.</p>
        <div class="login-error" id="err-totp"></div>
        <form id="form-totp">
          <div class="form-group">
            <label class="form-label req" for="inp-totp">Código TOTP</label>
            <input id="inp-totp" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" class="form-input font-mono" required autocomplete="one-time-code" placeholder="000000" style="letter-spacing:0.25em;font-size:1.25rem;text-align:center" />
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center" id="btn-totp">
            Verificar
          </button>
        </form>
        <button id="btn-back" class="btn btn-ghost btn-sm" style="margin-top:0.75rem">← Volver</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { supabase } from '../../scripts/admin/client.js';

  let factorId = null;
  let challengeId = null;

  // Redirect if already authenticated at AAL2
  (async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      const { data: aal } = await supabase.auth.mfa.getAuthenticatorAssuranceLevel();
      if (!aal || aal.currentLevel === aal.nextLevel) {
        window.location.replace('/admin/dashboard');
      }
    }
  })();

  function showError(id, msg) {
    const el = document.getElementById(id);
    el.textContent = msg;
    el.style.display = 'block';
  }

  function clearError(id) {
    const el = document.getElementById(id);
    el.textContent = '';
    el.style.display = 'none';
  }

  function setLoading(btnId, loading) {
    const btn = document.getElementById(btnId);
    btn.disabled = loading;
    btn.textContent = loading ? 'Cargando…' : btn.dataset.label ?? btn.textContent;
  }

  // Step 1: password
  document.getElementById('form-password').addEventListener('submit', async e => {
    e.preventDefault();
    clearError('err-password');
    const email    = document.getElementById('inp-email').value;
    const password = document.getElementById('inp-password').value;

    document.getElementById('btn-login').disabled = true;
    document.getElementById('btn-login').textContent = 'Verificando…';

    const { data, error } = await supabase.auth.signInWithPassword({ email, password });

    document.getElementById('btn-login').disabled = false;
    document.getElementById('btn-login').textContent = 'Ingresar';

    if (error) { showError('err-password', error.message); return; }

    const { data: aal } = await supabase.auth.mfa.getAuthenticatorAssuranceLevel();

    if (aal?.nextLevel === 'aal2') {
      // User has TOTP enrolled — start challenge
      const { data: factors } = await supabase.auth.mfa.listFactors();
      const totp = factors?.totp?.[0];
      if (!totp) { showError('err-password', 'No se encontró factor TOTP.'); return; }

      factorId = totp.id;
      const { data: ch, error: chErr } = await supabase.auth.mfa.challenge({ factorId });
      if (chErr) { showError('err-password', chErr.message); return; }

      challengeId = ch.id;
      document.getElementById('step-password').style.display = 'none';
      document.getElementById('step-totp').style.display = '';
      document.getElementById('inp-totp').focus();
    } else {
      // No MFA enrolled → setup
      window.location.replace('/admin/setup-mfa');
    }
  });

  // Step 2: TOTP
  document.getElementById('form-totp').addEventListener('submit', async e => {
    e.preventDefault();
    clearError('err-totp');
    const code = document.getElementById('inp-totp').value;
    document.getElementById('btn-totp').disabled = true;
    document.getElementById('btn-totp').textContent = 'Verificando…';

    const { error } = await supabase.auth.mfa.verify({ factorId, challengeId, code });

    document.getElementById('btn-totp').disabled = false;
    document.getElementById('btn-totp').textContent = 'Verificar';

    if (error) { showError('err-totp', 'Código incorrecto. Intente nuevamente.'); return; }

    window.location.replace('/admin/dashboard');
  });

  document.getElementById('btn-back').addEventListener('click', () => {
    document.getElementById('step-totp').style.display = 'none';
    document.getElementById('step-password').style.display = '';
  });
</script>
