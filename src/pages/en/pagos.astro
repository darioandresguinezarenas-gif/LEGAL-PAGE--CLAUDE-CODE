---
import BaseLayout from '../../layouts/BaseLayout.astro';
const lang = 'en';
const EDGE_INIT = `${import.meta.env.PUBLIC_SUPABASE_URL}/functions/v1/webpay-init`;
---

<BaseLayout
  title="Fee Payment in Curicó | Guíñez Galaz"
  description="Pay your legal fees securely by credit or debit card. Processed by Transbank Webpay."
  lang={lang}
>
  <main class="pagos-main">
    <div class="pagos-container">
      <div class="pagos-header">
        <div class="pagos-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
          </svg>
        </div>
        <h1>Fee Payment</h1>
        <p>Complete the form to pay your legal fees securely via Transbank Webpay.</p>
      </div>

      <form id="pagos-form" novalidate>
        <div class="form-field">
          <label for="nombre">Full name <span aria-hidden="true">*</span></label>
          <input type="text" id="nombre" name="nombre" maxlength="100" autocomplete="name" required />
        </div>
        <div class="form-field">
          <label for="email">Email address <span class="opt-hint">(optional — to receive receipt)</span></label>
          <input type="email" id="email" name="email" maxlength="254" autocomplete="email" placeholder="example@email.com" />
        </div>
        <div class="form-field">
          <label for="descripcion">Service description <span aria-hidden="true">*</span></label>
          <input type="text" id="descripcion" name="descripcion" maxlength="200"
            placeholder="e.g. Labour law consultation" required />
        </div>
        <div class="form-field">
          <label for="monto">Amount (CLP) <span aria-hidden="true">*</span></label>
          <div class="monto-wrap">
            <span class="monto-prefix">$</span>
            <input type="number" id="monto" name="monto" min="50" max="999999999" step="1" placeholder="50000" required />
          </div>
          <span class="field-hint">Minimum $50 · Whole numbers only · No additional fees</span>
        </div>
        <div class="form-error" id="form-error" role="alert"></div>
        <button type="submit" class="btn-pagar" id="btn-submit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
          </svg>
          Pay with Webpay
        </button>
        <div class="pagos-seguridad">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          100% secure · Processed by Transbank · Credit or debit card
        </div>
      </form>
    </div>
  </main>
</BaseLayout>

<script define:vars={{ EDGE_INIT, lang: lang }}>
const form = document.getElementById('pagos-form');
const btn  = document.getElementById('btn-submit');
const err  = document.getElementById('form-error');

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  err.textContent = '';
  btn.disabled = true;
  btn.textContent = 'Processing…';

  const nombre      = document.getElementById('nombre').value.trim();
  const email       = document.getElementById('email').value.trim();
  const descripcion = document.getElementById('descripcion').value.trim();
  const monto       = parseInt(document.getElementById('monto').value, 10);

  if (!nombre || !descripcion) { err.textContent = 'Please fill in all required fields.'; btn.disabled = false; btn.textContent = 'Pay with Webpay'; return; }
  if (!Number.isInteger(monto) || monto < 50) { err.textContent = 'Amount must be a whole number of at least $50 CLP.'; btn.disabled = false; btn.textContent = 'Pay with Webpay'; return; }

  try {
    const res  = await fetch(EDGE_INIT, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ monto, descripcion, nombre, email: email || undefined, lang }) });
    const data = await res.json();
    if (!res.ok || data.error) { err.textContent = data.error || 'Payment initiation failed. Please try again.'; btn.disabled = false; btn.textContent = 'Pay with Webpay'; return; }
    const f = document.createElement('form'); f.method = 'POST'; f.action = data.url;
    const i = document.createElement('input'); i.type = 'hidden'; i.name = 'token_ws'; i.value = data.token;
    f.appendChild(i); document.body.appendChild(f); f.submit();
  } catch { err.textContent = 'Connection error. Check your internet and try again.'; btn.disabled = false; btn.textContent = 'Pay with Webpay'; }
});
</script>

<style>
  .pagos-main { min-height:80vh;background:#F5F5F0;padding:4rem 1.5rem;display:flex;align-items:flex-start;justify-content:center; }
  .pagos-container { width:100%;max-width:520px;background:#fff;border-radius:12px;border:1px solid #E8E8E0;padding:2.5rem;box-shadow:0 4px 24px rgba(0,0,0,.07); }
  .pagos-header { text-align:center;margin-bottom:2rem; }
  .pagos-icon { width:56px;height:56px;background:#0D1F2D;color:#C9A84C;border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem; }
  .pagos-header h1 { font-family:'Cormorant Garamond',serif;font-size:1.9rem;font-weight:700;color:#0D1F2D;margin:0 0 .5rem; }
  .pagos-header p { font-size:.9rem;color:#6B6B6B;line-height:1.5;margin:0; }
  .form-field { margin-bottom:1.25rem;display:flex;flex-direction:column;gap:.4rem; }
  .form-field label { font-size:.875rem;font-weight:600;color:#1A1A1A; }
  .form-field label span { color:#C9A84C; }
  .form-field input { padding:.65rem .875rem;border:1.5px solid #E8E8E0;border-radius:8px;font-size:.9375rem;color:#1A1A1A;font-family:'DM Sans',sans-serif;transition:border-color .15s;outline:none;width:100%;box-sizing:border-box; }
  .form-field input:focus { border-color:#C9A84C; }
  .monto-wrap { display:flex;align-items:center;border:1.5px solid #E8E8E0;border-radius:8px;overflow:hidden;transition:border-color .15s; }
  .monto-wrap:focus-within { border-color:#C9A84C; }
  .monto-prefix { padding:.65rem .75rem;background:#F5F5F0;color:#6B6B6B;font-weight:600;font-size:.9375rem;border-right:1.5px solid #E8E8E0;flex-shrink:0; }
  .monto-wrap input { border:none;border-radius:0;padding-left:.75rem; }
  .monto-wrap input:focus { border:none;box-shadow:none; }
  .field-hint { font-size:.78rem;color:#6B6B6B; }
  .form-error { display:none;background:#FEF2F2;color:#B91C1C;border:1px solid #FECACA;border-radius:8px;padding:.65rem .875rem;font-size:.875rem;margin-bottom:1rem; }
  .form-error:not(:empty) { display:block; }
  .btn-pagar { width:100%;display:flex;align-items:center;justify-content:center;gap:8px;padding:.875rem 1.5rem;background:#C9A84C;color:#0D1F2D;border:none;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:1rem;font-weight:700;cursor:pointer;transition:background .2s,opacity .2s;margin-bottom:1rem; }
  .btn-pagar:hover:not(:disabled) { background:#b8943e; }
  .btn-pagar:disabled { opacity:.6;cursor:not-allowed; }
  .pagos-seguridad { display:flex;align-items:center;justify-content:center;gap:6px;font-size:.78rem;color:#6B6B6B;text-align:center; }
  .opt-hint { color: #6B6B6B; font-weight: 400; font-size: .78rem; }
  @media(max-width:600px){ .pagos-main{padding:2rem 1rem;} .pagos-container{padding:1.75rem 1.25rem;} }
</style>
