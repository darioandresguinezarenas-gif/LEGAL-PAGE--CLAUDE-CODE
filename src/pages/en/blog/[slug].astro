---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleDetail from '../../../components/blog/ArticleDetail.astro';
import { getArticulos, pickLang, type ArticuloRow } from '../../../lib/queries';
import { generateArticleSchema, generateBreadcrumbSchema } from '../../../lib/schema';

export async function getStaticPaths() {
  const articulos = await getArticulos();
  return articulos.map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}

interface Props { article: ArticuloRow }
const { article } = Astro.props;
const lang = 'en' as const;
const title = `${pickLang(article.titulo, lang)} | Guíñez Galaz Abogados`;
const description = pickLang(article.extracto, lang);
const BASE_URL = 'https://www.guinezgalaz.cl';

const pageJsonLd = [
  generateArticleSchema(
    {
      titulo:       article.titulo as Record<string, string>,
      extracto:     article.extracto as Record<string, string>,
      imagen_url:   article.imagen_url ?? `${BASE_URL}/og-default.jpg`,
      published_at: article.published_at ?? new Date().toISOString(),
      slug:         article.slug,
    },
    lang,
  ),
  generateBreadcrumbSchema([
    { name: 'Home',                       url: `${BASE_URL}/en` },
    { name: 'Blog',                       url: `${BASE_URL}/en/blog` },
    { name: pickLang(article.titulo, lang), url: `${BASE_URL}/en/blog/${article.slug}` },
  ]),
];
---
<BaseLayout title={title} description={description} lang={lang} ogImage={article.imagen_url ?? undefined} jsonLd={pageJsonLd}>
  <ArticleDetail article={article} lang={lang} />
</BaseLayout>
