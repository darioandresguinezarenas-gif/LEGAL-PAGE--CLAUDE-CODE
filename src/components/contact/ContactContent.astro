---
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const natures = ['laboral', 'civil', 'penal', 'familia', 'otro'];
const MAX_CHARS = 3000;
---

<section class="contact-section">
  <div class="contact-container">

    <!-- Columna izquierda: imagen + tarjeta de dirección -->
    <div class="contact-info-col">
      <div class="contact-image"
        style="background-image: url('https://images.unsplash.com/photo-1521791136064-7986c2920216?w=900&q=80')"
        role="img"
        aria-label={t(lang, 'contact.heroTitle')}
      ></div>

      <div class="contact-card">
        <p class="card-name">GUÍÑEZ GALAZ</p>

        <ul class="card-list">
          <li class="card-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A84C" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <span>{t(lang, 'footer.address')}</span>
          </li>
          <li class="card-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A84C" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/>
            </svg>
            <span>{t(lang, 'footer.phone')}</span>
          </li>
          <li class="card-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A84C" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>{t(lang, 'footer.hours')}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Columna derecha: formulario -->
    <div class="contact-form-col">
      <p class="form-label">{t(lang, 'contact.heroLabel')}</p>
      <h1 class="form-title">{t(lang, 'contact.title')}</h1>
      <p class="form-intro">{t(lang, 'contact.heroSubtitle')}</p>

      <form class="contact-form" id="contact-form" method="post" action="#">
        <!-- Honeypot anti-spam (oculto a usuarios) -->
        <div class="hp-field" aria-hidden="true">
          <label for="website">No completar</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="field">
          <label for="nombre">{t(lang, 'contact.name')}</label>
          <input type="text" id="nombre" name="nombre" required maxlength="120" autocomplete="name" />
        </div>

        <div class="field">
          <label for="email">{t(lang, 'contact.email')}</label>
          <input type="email" id="email" name="email" required maxlength="160" autocomplete="email" />
        </div>

        <div class="field">
          <label for="naturaleza">{t(lang, 'contact.nature')}</label>
          <select id="naturaleza" name="naturaleza" required>
            <option value="" disabled selected>{t(lang, 'contact.naturePlaceholder')}</option>
            {natures.map((n) => (
              <option value={n}>{t(lang, `contact.natures.${n}`)}</option>
            ))}
          </select>
        </div>

        <div class="field">
          <label for="mensaje">{t(lang, 'contact.message')}</label>
          <textarea id="mensaje" name="mensaje" required rows="6" maxlength={MAX_CHARS}></textarea>
          <span class="char-counter"><span id="char-count">0</span> / {MAX_CHARS}</span>
        </div>

        <button type="submit" class="form-submit">{t(lang, 'contact.send')}</button>
      </form>
    </div>

  </div>
</section>

<style>
  .contact-section {
    background: #ffffff;
    padding: 9rem 0 6rem;
  }

  .contact-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4rem;
    align-items: start;
  }

  /* Columna info */
  .contact-info-col {
    position: relative;
  }

  .contact-image {
    width: 100%;
    aspect-ratio: 3 / 4;
    background-size: cover;
    background-position: center;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1000px rgba(13, 31, 45, 0.2);
  }

  .contact-card {
    position: absolute;
    bottom: -1.5rem;
    left: 1.5rem;
    right: 1.5rem;
    background: #0D1F2D;
    padding: 1.75rem;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
  }

  .card-name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #C9A84C;
    margin-bottom: 1.125rem;
  }

  .card-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .card-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
  }

  .card-item svg { flex-shrink: 0; margin-top: 1px; }

  /* Columna formulario */
  .form-label {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #C9A84C;
    margin-bottom: 0.75rem;
  }

  .form-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: #0D1F2D;
    line-height: 1.1;
    margin-bottom: 0.875rem;
  }

  .form-intro {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1rem;
    color: rgba(26, 26, 26, 0.65);
    line-height: 1.65;
    margin-bottom: 2.25rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Honeypot oculto */
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: relative;
  }

  .field label {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #0D1F2D;
  }

  .field input,
  .field select,
  .field textarea {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.9375rem;
    color: #1A1A1A;
    background: #ffffff;
    border: 1px solid #E8E8E0;
    border-radius: 2px;
    padding: 0.75rem 0.875rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    width: 100%;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: #C9A84C;
    box-shadow: 0 0 0 3px rgba(201, 168, 76, 0.12);
  }

  .field textarea { resize: vertical; min-height: 140px; }

  .char-counter {
    align-self: flex-end;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.6875rem;
    color: rgba(26, 26, 26, 0.4);
  }

  .form-submit {
    align-self: flex-start;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
    background: #0D1F2D;
    border: none;
    padding: 0.9375rem 2.5rem;
    border-radius: 0;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .form-submit:hover {
    background: #C9A84C;
    color: #0D1F2D;
  }

  /* Responsive */
  @media (max-width: 820px) {
    .contact-container {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
    .contact-info-col { max-width: 480px; }
  }

  @media (max-width: 580px) {
    .contact-section { padding: 7rem 0 4rem; }
    .contact-card { position: static; margin-top: 1rem; left: 0; right: 0; }
    .contact-image { aspect-ratio: 16 / 10; }
  }
</style>

<script>
  const textarea = document.getElementById('mensaje') as HTMLTextAreaElement | null;
  const counter = document.getElementById('char-count');

  if (textarea && counter) {
    const update = () => { counter.textContent = String(textarea.value.length); };
    textarea.addEventListener('input', update);
    update();
  }
</script>
