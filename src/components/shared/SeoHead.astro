---
interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en' | 'zh';
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  lang,
  ogImage = 'https://www.guinezgalaz.cl/og-default.jpg',
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://www.guinezgalaz.cl').href;

const hreflangPaths = Astro.url.pathname.replace(/^\/(es|en|zh)/, '');
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- hreflang para multiidioma -->
<link rel="alternate" hreflang="es-CL" href={`https://www.guinezgalaz.cl/es${hreflangPaths}`} />
<link rel="alternate" hreflang="en-US" href={`https://www.guinezgalaz.cl/en${hreflangPaths}`} />
<link rel="alternate" hreflang="zh-CN" href={`https://www.guinezgalaz.cl/zh${hreflangPaths}`} />
<link rel="alternate" hreflang="x-default" href={`https://www.guinezgalaz.cl/es${hreflangPaths}`} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : lang === 'en' ? 'en_US' : 'es_CL'} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
