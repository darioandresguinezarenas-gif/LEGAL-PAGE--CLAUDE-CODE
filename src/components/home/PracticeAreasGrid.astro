---
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Placeholder data — Fase 4: fetch desde Supabase (activo=true, deleted_at IS NULL)
const areas = [
  {
    slug: 'laboral',
    key: 'laboral',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>`,
  },
  {
    slug: 'civil',
    key: 'civil',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>`,
  },
  {
    slug: 'penal',
    key: 'penal',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
  {
    slug: 'familia',
    key: 'familia',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    slug: 'corporativo',
    key: 'corporativo',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>`,
  },
  {
    slug: 'contratos',
    key: 'contratos',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>`,
  },
];
---

<section class="areas-section">
  <div class="areas-container">
    <!-- Header -->
    <div class="areas-header">
      <h2 class="areas-title">{t(lang, 'areas.sectionTitle')}</h2>
      <p class="areas-subtitle">{t(lang, 'areas.sectionSubtitle')}</p>
    </div>

    <!-- Grid -->
    <div class="areas-grid">
      {areas.map((area) => (
        <article class="area-card">
          <div class="area-card-inner">
            <div class="area-icon" set:html={area.icon} />
            <h3 class="area-card-title">
              {t(lang, `areas.${area.key}.title`)}
            </h3>
            <p class="area-card-desc">
              {t(lang, `areas.${area.key}.desc`)}
            </p>
            <a href={`/${lang}/areas-practica/${area.slug}`} class="area-explore-link">
              {t(lang, 'areas.explore')}
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .areas-section {
    background: #ffffff;
    padding: 6rem 0;
  }

  .areas-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  /* ── Header ───────────────────────────────────── */
  .areas-header {
    margin-bottom: 3.5rem;
  }

  .areas-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: #0D1F2D;
    line-height: 1.1;
    margin-bottom: 0.875rem;
  }

  .areas-subtitle {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1rem;
    color: rgba(26, 26, 26, 0.6);
    max-width: 520px;
    line-height: 1.65;
  }

  /* ── Grid ─────────────────────────────────────── */
  .areas-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  /* ── Card ─────────────────────────────────────── */
  .area-card {
    border: 1px solid #E8E8E0;
    background: #ffffff;
    transition:
      box-shadow 0.25s ease,
      border-left-color 0.25s ease,
      transform 0.2s ease;
    cursor: pointer;
  }

  .area-card:hover {
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.10);
    border-left: 3px solid #C9A84C;
    transform: translateY(-2px);
  }

  .area-card-inner {
    padding: 2rem 1.75rem;
  }

  /* ── Icon ─────────────────────────────────────── */
  .area-icon {
    width: 24px;
    height: 24px;
    color: #0D1F2D;
    margin-bottom: 1.25rem;
  }

  /* ── Text ─────────────────────────────────────── */
  .area-card-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.3125rem;
    font-weight: 700;
    color: #0D1F2D;
    margin-bottom: 0.625rem;
    line-height: 1.2;
  }

  .area-card-desc {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.875rem;
    color: rgba(26, 26, 26, 0.65);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  /* ── Explore link ─────────────────────────────── */
  .area-explore-link {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #C9A84C;
    transition: letter-spacing 0.2s ease;
  }

  .area-explore-link:hover {
    letter-spacing: 0.12em;
  }

  /* ── Responsive ───────────────────────────────── */
  @media (max-width: 900px) {
    .areas-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 580px) {
    .areas-section { padding: 4rem 0; }
    .areas-grid { grid-template-columns: 1fr; }
    .area-card:hover { border-left: 3px solid #C9A84C; transform: none; }
  }
</style>
