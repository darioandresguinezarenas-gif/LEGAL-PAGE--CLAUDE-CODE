---
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
import { getAreas, pickLang } from '../../lib/queries';
import { lucideIcon } from '../../lib/icons';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const dbAreas = await getAreas();

type CardData = { slug: string; icon: string; title: string; desc: string };

const areas: CardData[] = dbAreas.length > 0
  ? dbAreas.map((a) => ({
      slug: a.slug,
      icon: lucideIcon(a.icono, a.slug),
      title: pickLang(a.titulo, lang) || t(lang, `areas.${a.slug}.title`),
      desc: pickLang(a.descripcion, lang) || t(lang, `areas.${a.slug}.desc`),
    }))
  : (['laboral', 'civil', 'penal', 'familia', 'corporativo', 'contratos'] as const).map((slug) => ({
      slug,
      icon: lucideIcon(null, slug),
      title: t(lang, `areas.${slug}.title`),
      desc: t(lang, `areas.${slug}.desc`),
    }));
---

<section class="areas-section">
  <div class="areas-container">
    <!-- Header -->
    <div class="areas-header">
      <h2 class="areas-title">{t(lang, 'areas.sectionTitle')}</h2>
      <p class="areas-subtitle">{t(lang, 'areas.sectionSubtitle')}</p>
    </div>

    <!-- Grid -->
    <div class="areas-grid">
      {areas.map((area) => (
        <article class="area-card">
          <div class="area-card-inner">
            <div class="area-icon" set:html={area.icon} />
            <h3 class="area-card-title">{area.title}</h3>
            <p class="area-card-desc">{area.desc}</p>
            <a href={`/${lang}/areas-practica/${area.slug}`} class="area-explore-link">
              {t(lang, 'areas.explore')}
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .areas-section {
    background: #ffffff;
    padding: 6rem 0;
  }

  .areas-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  /* ── Header ───────────────────────────────────── */
  .areas-header {
    margin-bottom: 3.5rem;
  }

  .areas-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: #0D1F2D;
    line-height: 1.1;
    margin-bottom: 0.875rem;
  }

  .areas-subtitle {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1rem;
    color: rgba(26, 26, 26, 0.6);
    max-width: 520px;
    line-height: 1.65;
  }

  /* ── Grid ─────────────────────────────────────── */
  .areas-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  /* ── Card ─────────────────────────────────────── */
  .area-card {
    border: 1px solid #E8E8E0;
    background: #ffffff;
    transition:
      box-shadow 0.25s ease,
      border-left-color 0.25s ease,
      transform 0.2s ease;
    cursor: pointer;
  }

  .area-card:hover {
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.10);
    border-left: 3px solid #C9A84C;
    transform: translateY(-2px);
  }

  .area-card-inner {
    padding: 2rem 1.75rem;
  }

  /* ── Icon ─────────────────────────────────────── */
  .area-icon {
    width: 24px;
    height: 24px;
    color: #0D1F2D;
    margin-bottom: 1.25rem;
  }

  /* ── Text ─────────────────────────────────────── */
  .area-card-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.3125rem;
    font-weight: 700;
    color: #0D1F2D;
    margin-bottom: 0.625rem;
    line-height: 1.2;
  }

  .area-card-desc {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.875rem;
    color: rgba(26, 26, 26, 0.65);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  /* ── Explore link ─────────────────────────────── */
  .area-explore-link {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #C9A84C;
    transition: letter-spacing 0.2s ease;
  }

  .area-explore-link:hover {
    letter-spacing: 0.12em;
  }

  /* ── Responsive ───────────────────────────────── */
  @media (max-width: 900px) {
    .areas-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 580px) {
    .areas-section { padding: 4rem 0; }
    .areas-grid { grid-template-columns: 1fr; }
    .area-card:hover { border-left: 3px solid #C9A84C; transform: none; }
  }
</style>
