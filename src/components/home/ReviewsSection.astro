---
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
import es from '../../i18n/es.json';
import en from '../../i18n/en.json';
import zh from '../../i18n/zh.json';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Google Places API - fetch en tiempo de build (SSG)
// Requiere PUBLIC_GOOGLE_PLACE_ID y PUBLIC_GOOGLE_PLACES_API_KEY en .env
// Dejar vacio hasta que el Google Business Profile este verificado.
const placeId = import.meta.env.PUBLIC_GOOGLE_PLACE_ID;
const apiKey  = import.meta.env.PUBLIC_GOOGLE_PLACES_API_KEY;

type GoogleReview = {
  author_name: string;
  profile_photo_url: string;
  rating: number;
  relative_time_description: string;
  text: string;
};

let liveReviews: GoogleReview[] = [];
let aggregateRating = 5.0;
let isLive = false;

if (placeId && apiKey) {
  try {
    const apiLang = lang === 'zh' ? 'zh-TW' : lang;
    const url = `https://maps.googleapis.com/maps/api/place/details/json` +
      `?place_id=${encodeURIComponent(placeId)}` +
      `&fields=reviews,rating` +
      `&language=${apiLang}` +
      `&reviews_sort=newest` +
      `&key=${encodeURIComponent(apiKey)}`;
    const res = await fetch(url);
    if (res.ok) {
      const data = await res.json();
      if (data.result?.reviews?.length) {
        liveReviews     = data.result.reviews.slice(0, 3);
        aggregateRating = data.result.rating ?? 5.0;
        isLive = true;
      }
    }
  } catch (_) {
    // Fallback silencioso a placeholder
  }
}

// Datos placeholder - se usan hasta que Google Business Profile este listo
const translations = { es, en, zh } as const;
const placeholderItems = (translations[lang] as typeof es).reviews.items;

const avatarColors = ['#C9A84C', '#0D1F2D', '#6B7B8A'];
const stars = Array.from({ length: 5 });
---

<section class="reviews-section">
  <div class="reviews-container">

    <!-- Header -->
    <div class="reviews-header">
      <svg class="google-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-label="Google Reviews" role="img">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
      </svg>

      <h2 class="reviews-title">{t(lang, 'reviews.sectionTitle')}</h2>

      <div class="aggregate-row" aria-label={`${aggregateRating.toFixed(1)} / 5`}>
        <div class="aggregate-stars">
          {stars.map((_, i) => (
            <svg class="star" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
              style={`fill:${i < Math.round(aggregateRating) ? '#C9A84C' : '#E0E0E0'}`}>
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          ))}
        </div>
        <span class="aggregate-score">{aggregateRating.toFixed(1)}</span>
        {isLive && <span class="live-badge">Google Reviews</span>}
      </div>
    </div>

    {isLive ? (
      /* Resenas reales desde Google Places */
      <div class="reviews-grid">
        {liveReviews.map((review) => (
          <article class="review-card">
            <div class="card-stars" aria-label={`${review.rating} estrellas`}>
              {stars.map((_, i) => (
                <svg class="star" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
                  style={`fill:${i < review.rating ? '#C9A84C' : '#E0E0E0'}`}>
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>
            <blockquote class="review-text">
              <p>"{review.text.length > 200 ? review.text.slice(0, 200) + '...' : review.text}"</p>
            </blockquote>
            <footer class="review-author">
              <img
                src={review.profile_photo_url}
                alt={review.author_name}
                class="review-photo"
                width="40"
                height="40"
                loading="lazy"
                referrerpolicy="no-referrer"
              />
              <div class="review-info">
                <span class="review-name">{review.author_name}</span>
                <span class="review-date">{review.relative_time_description}</span>
              </div>
            </footer>
          </article>
        ))}
      </div>
    ) : placeId ? (
      /* Place ID configurado pero sin resultados */
      <div class="reviews-pending">
        <p class="pending-text">{t(lang, 'reviews.pendingDesc')}</p>
      </div>
    ) : (
      /* Placeholder hasta crear Google Business Profile */
      <div class="reviews-grid">
        {placeholderItems.map((review, i) => (
          <article class="review-card review-card--placeholder">
            <div class="card-stars" aria-label="5 estrellas">
              {stars.map(() => (
                <svg class="star" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="fill:#C9A84C">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>
            <blockquote class="review-text">
              <p>"{review.text}"</p>
            </blockquote>
            <footer class="review-author">
              <div
                class="review-avatar"
                style={`background:${avatarColors[i] ?? '#0D1F2D'}`}
                aria-hidden="true"
              >
                {review.name.charAt(0).toUpperCase()}
              </div>
              <div class="review-info">
                <span class="review-name">{review.name}</span>
                <span class="review-date">{review.date}</span>
              </div>
            </footer>
          </article>
        ))}
      </div>
    )}

    {!isLive && (
      <p class="placeholder-notice">
        {lang === 'es'
          ? 'Las resenas reales se cargaran automaticamente al configurar PUBLIC_GOOGLE_PLACE_ID.'
          : lang === 'en'
          ? 'Real reviews will load automatically once PUBLIC_GOOGLE_PLACE_ID is configured.'
          : '配置 PUBLIC_GOOGLE_PLACE_ID 后，真实评论将自动加载。'}
      </p>
    )}

  </div>
</section>

<style>
  .reviews-section {
    background: #ffffff;
    padding: 6rem 0;
    border-top: 1px solid #E8E8E0;
  }

  .reviews-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .reviews-header {
    text-align: center;
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .google-icon { width: 32px; height: 32px; }

  .reviews-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: #0D1F2D;
    line-height: 1.15;
    max-width: 560px;
  }

  .aggregate-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .aggregate-stars, .card-stars {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .star { width: 16px; height: 16px; flex-shrink: 0; }

  .aggregate-score {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    color: #0D1F2D;
  }

  .live-badge {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: #E8F5E9;
    color: #2E7D32;
    padding: 3px 8px;
    border-radius: 999px;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .review-card {
    border: 1px solid #E8E8E0;
    border-radius: 4px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: box-shadow 0.25s ease, transform 0.2s ease;
  }

  .review-card:hover {
    box-shadow: 0 6px 20px rgba(0,0,0,.08);
    transform: translateY(-2px);
  }

  .review-card--placeholder { opacity: 0.92; }

  .review-text { flex: 1; }

  .review-text p {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1rem;
    font-style: italic;
    line-height: 1.7;
    color: rgba(26,26,26,.80);
  }

  .review-author {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .review-photo {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .review-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.125rem;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
  }

  .review-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .review-name {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: #0D1F2D;
  }

  .review-date {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    color: rgba(26,26,26,.50);
  }

  .reviews-pending {
    text-align: center;
    padding: 3rem;
    border: 1px dashed #E8E8E0;
    border-radius: 4px;
  }

  .pending-text {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.9375rem;
    color: rgba(26,26,26,.55);
  }

  .placeholder-notice {
    margin-top: 1.75rem;
    text-align: center;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    color: rgba(26,26,26,.35);
  }

  @media (max-width: 900px) { .reviews-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 580px) {
    .reviews-section { padding: 4rem 0; }
    .reviews-grid { grid-template-columns: 1fr; }
  }
</style>
