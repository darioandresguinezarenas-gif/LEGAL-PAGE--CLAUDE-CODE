---
interface Props {
  lang: 'es' | 'en' | 'zh';
}
const { lang } = Astro.props;
// TODO: Fase 4 — fetch clientes_destacados desde Supabase (activo=true, deleted_at IS NULL)
const clients: any[] = [];
---
<section class="clients-section">
  <p class="clients-label">
    {lang === 'es' ? 'HAN CONFIADO EN NOSOTROS' : lang === 'en' ? 'THEY TRUSTED US' : '他们信任我们'}
  </p>
  <div class="clients-logos">
    {clients.map((c) => (
      <img src={c.logo_url} alt={c.nombre} class="client-logo" loading="lazy" />
    ))}
  </div>
</section>
