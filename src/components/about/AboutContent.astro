---
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Placeholder del equipo - Fase posterior: fetch desde Supabase
//   SELECT * FROM abogados WHERE activo = true AND deleted_at IS NULL ORDER BY orden
// Los datos reales se cargaran desde el panel de administracion.
type TeamMember = {
  nombre: string;
  cargo: Record<Lang, string>;
  bio: Record<Lang, string>;
  especialidades: Record<Lang, string[]>;
  anos: number;
  foto_url: string | null;
};

const team: TeamMember[] = [
  {
    nombre: 'Patricio Guíñez',
    cargo: { es: 'Socio Fundador', en: 'Founding Partner', zh: '创始合伙人' },
    bio: {
      es: 'Con casi dos décadas de trayectoria, lidera el área de litigios laborales y civiles del estudio. Su enfoque estratégico y su sólida experiencia en tribunales respaldan cada defensa, combinando rigor técnico con una visión orientada a resultados concretos para sus clientes.',
      en: 'With nearly two decades of experience, he leads the firm’s labour and civil litigation practice. His strategic approach and solid courtroom experience back every defense, combining technical rigor with a vision focused on concrete results for his clients.',
      zh: '凭借近二十年的经验，他领导着事务所的劳动和民事诉讼业务。他的战略眼光和扎实的庭审经验为每一次辩护提供支持，将专业的技术与为客户取得切实成果的愿景相结合。',
    },
    especialidades: {
      es: ['Derecho Laboral', 'Derecho Civil'],
      en: ['Labour Law', 'Civil Law'],
      zh: ['劳动法', '民法'],
    },
    anos: 18,
    foto_url: null,
  },
  {
    nombre: 'Camila Galaz',
    cargo: { es: 'Socia', en: 'Partner', zh: '合伙人' },
    bio: {
      es: 'Especialista en derecho de familia y mediación, combina el rigor jurídico con un trato cercano y humano en cada proceso. Acompaña a las familias en momentos sensibles con empatía, claridad y un firme compromiso con la protección de sus derechos.',
      en: 'A specialist in family law and mediation, she combines legal rigor with a close, human approach in every case. She supports families through sensitive moments with empathy, clarity and a firm commitment to protecting their rights.',
      zh: '作为家庭法和调解专家，她在每个案件中将法律的严谨与亲切人性化的服务相结合。她以同理心、清晰的思路和保护客户权利的坚定承诺，陪伴家庭度过敏感时刻。',
    },
    especialidades: {
      es: ['Derecho de Familia', 'Derecho Civil'],
      en: ['Family Law', 'Civil Law'],
      zh: ['家庭法', '民法'],
    },
    anos: 14,
    foto_url: null,
  },
];

const getInitials = (nombre: string) =>
  nombre
    .split(' ')
    .map((w) => w.charAt(0))
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

<!-- Hero interior -->
<section class="about-hero">
  <div class="about-hero-inner">
    <p class="about-hero-label">{t(lang, 'about.heroLabel')}</p>
    <h1 class="about-hero-title">{t(lang, 'about.heroTitle')}</h1>
    <p class="about-hero-subtitle">{t(lang, 'about.heroSubtitle')}</p>
  </div>
</section>

<!-- Intro -->
<section class="about-intro">
  <div class="about-intro-inner">
    <h2 class="about-intro-title">{t(lang, 'about.introTitle')}</h2>
    <p class="about-intro-body">{t(lang, 'about.introBody')}</p>
  </div>
</section>

<!-- Equipo: layout alternado foto/texto -->
<section class="team-section">
  <div class="team-container">
    {team.map((member, i) => (
      <article class:list={['team-row', { reversed: i % 2 === 1 }]}>
        <!-- Foto -->
        <div class="team-photo-col">
          {member.foto_url
            ? <img src={member.foto_url} alt={member.nombre} class="team-photo" loading="lazy" />
            : (
              <div class="team-photo-placeholder" aria-hidden="true">
                <span class="team-monogram">{getInitials(member.nombre)}</span>
              </div>
            )
          }
          <div class="team-badge">
            <span class="badge-number">{member.anos}</span>
            <span class="badge-label">{t(lang, 'about.experienceLabel')}</span>
          </div>
        </div>

        <!-- Texto -->
        <div class="team-text-col">
          <h2 class="team-name">{member.nombre}</h2>
          <p class="team-role">{member.cargo[lang]}</p>
          <p class="team-bio">{member.bio[lang]}</p>
          <div class="team-specialties">
            <span class="specialties-label">{t(lang, 'about.specialtiesLabel')}</span>
            <ul class="specialties-list">
              {member.especialidades[lang].map((esp) => (
                <li class="specialty-tag">{esp}</li>
              ))}
            </ul>
          </div>
          <a href={`/${lang}/contacto`} class="team-cta">{t(lang, 'about.scheduleButton')}</a>
        </div>
      </article>
    ))}

    <p class="team-notice">{t(lang, 'about.teamNotice')}</p>
  </div>
</section>

<!-- CTA final -->
<section class="about-cta">
  <div class="about-cta-inner">
    <h2 class="about-cta-title">{t(lang, 'about.ctaTitle')}</h2>
    <p class="about-cta-text">{t(lang, 'about.ctaText')}</p>
    <a href={`/${lang}/contacto`} class="about-cta-btn">{t(lang, 'about.ctaButton')}</a>
  </div>
</section>

<style>
  /* Hero interior */
  .about-hero {
    background: #0D1F2D;
    padding: 9rem 0 5rem;
    text-align: center;
  }

  .about-hero-inner {
    max-width: 760px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .about-hero-label {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #C9A84C;
    margin-bottom: 1rem;
  }

  .about-hero-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .about-hero-subtitle {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.72);
  }

  /* Intro */
  .about-intro {
    background: #ffffff;
    padding: 5rem 0 2rem;
  }

  .about-intro-inner {
    max-width: 760px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    text-align: center;
  }

  .about-intro-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.75rem, 3.5vw, 2.375rem);
    font-weight: 700;
    color: #0D1F2D;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  .about-intro-body {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: rgba(26, 26, 26, 0.72);
  }

  /* Equipo alternado */
  .team-section {
    background: #ffffff;
    padding: 3rem 0 6rem;
  }

  .team-container {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .team-row {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 3.5rem;
    align-items: center;
    padding: 3.5rem 0;
    border-bottom: 1px solid #E8E8E0;
  }

  .team-row:last-of-type { border-bottom: none; }

  .team-row.reversed .team-photo-col { order: 2; }
  .team-row.reversed .team-text-col { order: 1; }

  /* Foto */
  .team-photo-col {
    position: relative;
  }

  .team-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 2px;
  }

  .team-photo-placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 2px;
    background: linear-gradient(150deg, #0D1F2D 0%, #1f3a4d 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .team-monogram {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 4rem;
    font-weight: 700;
    color: rgba(201, 168, 76, 0.55);
    letter-spacing: 0.05em;
  }

  .team-badge {
    position: absolute;
    bottom: -1.25rem;
    right: -1.25rem;
    background: #C9A84C;
    color: #0D1F2D;
    padding: 1rem 1.25rem;
    text-align: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }

  .badge-number {
    display: block;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1;
  }

  .badge-label {
    display: block;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 2px;
    max-width: 90px;
  }

  /* Texto */
  .team-name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: #0D1F2D;
    line-height: 1.1;
    margin-bottom: 0.25rem;
  }

  .team-role {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #C9A84C;
    margin-bottom: 1.25rem;
  }

  .team-bio {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(26, 26, 26, 0.7);
    margin-bottom: 1.5rem;
  }

  .team-specialties {
    margin-bottom: 1.75rem;
  }

  .specialties-label {
    display: block;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(26, 26, 26, 0.4);
    margin-bottom: 0.625rem;
  }

  .specialties-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .specialty-tag {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    color: #0D1F2D;
    background: #F5F5F0;
    border: 1px solid #E8E8E0;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }

  .team-cta {
    display: inline-block;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
    background: #0D1F2D;
    padding: 0.8125rem 1.75rem;
    border-radius: 0;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .team-cta:hover {
    background: #C9A84C;
    color: #0D1F2D;
  }

  .team-notice {
    margin-top: 3rem;
    text-align: center;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    color: rgba(26, 26, 26, 0.35);
  }

  /* CTA final */
  .about-cta {
    background: #0D1F2D;
    padding: 5rem 0;
    text-align: center;
  }

  .about-cta-inner {
    max-width: 620px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .about-cta-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.75rem, 3.5vw, 2.375rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 0.875rem;
  }

  .about-cta-text {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .about-cta-btn {
    display: inline-block;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #0D1F2D;
    background: #C9A84C;
    padding: 0.9375rem 2.5rem;
    border-radius: 0;
    transition: background 0.2s ease;
  }

  .about-cta-btn:hover { background: #b8953e; }

  /* Responsive */
  @media (max-width: 820px) {
    .team-row,
    .team-row.reversed {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      max-width: 460px;
      margin-inline: auto;
    }
    .team-row .team-photo-col,
    .team-row .team-text-col,
    .team-row.reversed .team-photo-col,
    .team-row.reversed .team-text-col { order: initial; }
    .team-badge { right: 1rem; }
  }

  @media (max-width: 580px) {
    .about-hero { padding: 7rem 0 4rem; }
    .about-intro { padding: 4rem 0 1rem; }
    .team-section { padding: 2rem 0 4rem; }
    .about-cta { padding: 4rem 0; }
  }
</style>
