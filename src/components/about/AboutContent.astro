---
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
import { getAbogados, pickLang } from '../../lib/queries';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

type TeamMember = {
  nombre: string;
  cargo: Record<Lang, string>;
  bio: Record<Lang, string>;
  especialidades: Record<Lang, string[]>;
  anos: number;
  foto_url: string | null;
  email?: string | null;
  telefono?: string | null;
  linkedin_url?: string | null;
};

const dbAbogados = await getAbogados();

// IMPORTANTE: Darío Guíñez es Egresado de Derecho — NUNCA usar "Abogado" para referirse a él.
// Catalina Galaz es Abogada habilitada. Atiende además casos en Valparaíso de forma presencial
// (sin oficina física aún en esa ciudad).
const placeholderTeam: TeamMember[] = [
  {
    nombre: 'Darío Guíñez Arenas',
    cargo: {
      es: 'Egresado de Derecho · Socio Fundador',
      en: 'Law Graduate · Founding Partner',
      zh: '法律毕业生 · 创始合伙人',
    },
    bio: {
      es: 'Egresado de Derecho y fundador del estudio. Lidera la gestión institucional y la coordinación estratégica de los casos en las áreas Laboral, Civil, Corporativa y Penal Económico. Su trabajo combina rigor técnico, visión integral del cliente y un enfoque orientado a resultados concretos.',
      en: 'Law graduate and founder of the firm. He leads institutional management and strategic coordination of cases in Labour, Civil, Corporate and Economic Criminal Law. His work combines technical rigor, an integral view of the client and a results-driven approach.',
      zh: '法律毕业生，事务所创始人。负责事务所的整体管理及劳动法、民法、公司法与经济刑法案件的战略协调。其工作将专业的技术、对客户的整体视角与以成果为导向的方法相结合。',
    },
    especialidades: {
      es: ['Derecho Laboral', 'Derecho Civil', 'Derecho Corporativo'],
      en: ['Labour Law', 'Civil Law', 'Corporate Law'],
      zh: ['劳动法', '民法', '公司法'],
    },
    anos: 0,
    foto_url: null,
    email: 'dguinezlegal@gmail.com',
    telefono: '+56971704455',
    linkedin_url: null,
  },
  {
    nombre: 'Catalina Galaz Díaz',
    cargo: {
      es: 'Abogada · Socia Fundadora',
      en: 'Attorney · Founding Partner',
      zh: '律师 · 创始合伙人',
    },
    bio: {
      es: 'Abogada del estudio y socia. Se desempeña en Derecho Penal, Familia y Civil, con un trato cercano y profesional con cada cliente. Atiende casos en Curicó y también de forma presencial en Valparaíso, según las necesidades del caso.',
      en: 'Attorney and partner of the firm. She practices Criminal, Family and Civil Law, with a close and professional approach to every client. She handles cases in Curicó and also in person in Valparaíso, depending on case requirements.',
      zh: '事务所律师与合伙人。从事刑法、家庭法和民法工作，以亲切而专业的态度对待每一位客户。可在库里科及瓦尔帕莱索现场处理案件，视案件需要而定。',
    },
    especialidades: {
      es: ['Derecho Penal', 'Derecho de Familia', 'Derecho Civil'],
      en: ['Criminal Law', 'Family Law', 'Civil Law'],
      zh: ['刑法', '家庭法', '民法'],
    },
    anos: 0,
    foto_url: null,
    email: 'catalinagalazdz@gmail.com',
    telefono: '+56992355905',
    linkedin_url: null,
  },
];

const team: TeamMember[] = dbAbogados.length > 0
  ? dbAbogados.map((a) => ({
      nombre: a.nombre,
      cargo: {
        es: pickLang(a.cargo, 'es'),
        en: pickLang(a.cargo, 'en'),
        zh: pickLang(a.cargo, 'zh'),
      } as Record<Lang, string>,
      bio: {
        es: pickLang(a.bio, 'es'),
        en: pickLang(a.bio, 'en'),
        zh: pickLang(a.bio, 'zh'),
      } as Record<Lang, string>,
      especialidades: {
        es: a.especialidades ?? [],
        en: a.especialidades ?? [],
        zh: a.especialidades ?? [],
      } as Record<Lang, string[]>,
      anos: a.anos_trayectoria ?? 0,
      foto_url: a.foto_url,
      email: a.email,
      telefono: a.telefono,
      linkedin_url: a.linkedin_url,
    }))
  : placeholderTeam;

const formatTel = (raw: string | null | undefined): string => {
  if (!raw) return '';
  // +56971704455 → +56 9 7170 4455
  const digits = raw.replace(/\D/g, '');
  if (digits.startsWith('569') && digits.length === 11) {
    return `+56 9 ${digits.slice(3, 7)} ${digits.slice(7)}`;
  }
  return raw;
};

const getInitials = (nombre: string) =>
  nombre
    .split(' ')
    .map((w) => w.charAt(0))
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

<!-- Hero interior -->
<section class="about-hero">
  <div class="about-hero-inner">
    <p class="about-hero-label">{t(lang, 'about.heroLabel')}</p>
    <h1 class="about-hero-title">{t(lang, 'about.heroTitle')}</h1>
    <p class="about-hero-subtitle">{t(lang, 'about.heroSubtitle')}</p>
  </div>
</section>

<!-- Intro -->
<section class="about-intro">
  <div class="about-intro-inner">
    <h2 class="about-intro-title">{t(lang, 'about.introTitle')}</h2>
    <p class="about-intro-body">{t(lang, 'about.introBody')}</p>
  </div>
</section>

<!-- Equipo: layout alternado foto/texto -->
<section class="team-section">
  <div class="team-container">
    {team.map((member, i) => (
      <article class:list={['team-row', { reversed: i % 2 === 1 }]}>
        <!-- Foto -->
        <div class="team-photo-col">
          {member.foto_url
            ? <img src={member.foto_url} alt={member.nombre} class="team-photo" loading="lazy" />
            : (
              <div class="team-photo-placeholder" aria-hidden="true">
                <span class="team-monogram">{getInitials(member.nombre)}</span>
              </div>
            )
          }
          {member.anos > 0 && (
            <div class="team-badge">
              <span class="badge-number">{member.anos}</span>
              <span class="badge-label">{t(lang, 'about.experienceLabel')}</span>
            </div>
          )}
        </div>

        <!-- Texto -->
        <div class="team-text-col">
          <h2 class="team-name">{member.nombre}</h2>
          <p class="team-role">{member.cargo[lang]}</p>
          <p class="team-bio">{member.bio[lang]}</p>
          <div class="team-specialties">
            <span class="specialties-label">{t(lang, 'about.specialtiesLabel')}</span>
            <ul class="specialties-list">
              {member.especialidades[lang].map((esp) => (
                <li class="specialty-tag">{esp}</li>
              ))}
            </ul>
          </div>

          {(member.email || member.telefono || member.linkedin_url) && (
            <ul class="team-contact" aria-label={lang === 'es' ? 'Contacto directo' : lang === 'en' ? 'Direct contact' : '直接联系'}>
              {member.telefono && (
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42A2 2 0 0 1 3.58 1.25h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.8a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.02z"/></svg>
                  <a href={`tel:${member.telefono.replace(/\s/g, '')}`}>{formatTel(member.telefono)}</a>
                </li>
              )}
              {member.email && (
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                  <a href={`mailto:${member.email}`}>{member.email}</a>
                </li>
              )}
              {member.linkedin_url && (
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                  <a href={member.linkedin_url} rel="noopener noreferrer" target="_blank">LinkedIn</a>
                </li>
              )}
            </ul>
          )}

          <a href={`/${lang}/contacto`} class="team-cta">{t(lang, 'about.scheduleButton')}</a>
        </div>
      </article>
    ))}

    <p class="team-notice">{t(lang, 'about.teamNotice')}</p>
  </div>
</section>

<!-- CTA final -->
<section class="about-cta">
  <div class="about-cta-inner">
    <h2 class="about-cta-title">{t(lang, 'about.ctaTitle')}</h2>
    <p class="about-cta-text">{t(lang, 'about.ctaText')}</p>
    <a href={`/${lang}/contacto`} class="about-cta-btn">{t(lang, 'about.ctaButton')}</a>
  </div>
</section>

<style>
  /* Hero interior */
  .about-hero {
    background: #0D1F2D;
    padding: 9rem 0 5rem;
    text-align: center;
  }

  .about-hero-inner {
    max-width: 760px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .about-hero-label {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #C9A84C;
    margin-bottom: 1rem;
  }

  .about-hero-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .about-hero-subtitle {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.72);
  }

  /* Intro */
  .about-intro {
    background: #ffffff;
    padding: 5rem 0 2rem;
  }

  .about-intro-inner {
    max-width: 760px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    text-align: center;
  }

  .about-intro-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.75rem, 3.5vw, 2.375rem);
    font-weight: 700;
    color: #0D1F2D;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  .about-intro-body {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: rgba(26, 26, 26, 0.72);
  }

  /* Equipo alternado */
  .team-section {
    background: #ffffff;
    padding: 3rem 0 6rem;
  }

  .team-container {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .team-row {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 3.5rem;
    align-items: center;
    padding: 3.5rem 0;
    border-bottom: 1px solid #E8E8E0;
  }

  .team-row:last-of-type { border-bottom: none; }

  .team-row.reversed .team-photo-col { order: 2; }
  .team-row.reversed .team-text-col { order: 1; }

  /* Foto */
  .team-photo-col {
    position: relative;
  }

  .team-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 2px;
  }

  .team-photo-placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 2px;
    background: linear-gradient(150deg, #0D1F2D 0%, #1f3a4d 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .team-monogram {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 4rem;
    font-weight: 700;
    color: rgba(201, 168, 76, 0.55);
    letter-spacing: 0.05em;
  }

  .team-badge {
    position: absolute;
    bottom: -1.25rem;
    right: -1.25rem;
    background: #C9A84C;
    color: #0D1F2D;
    padding: 1rem 1.25rem;
    text-align: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }

  .badge-number {
    display: block;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1;
  }

  .badge-label {
    display: block;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 2px;
    max-width: 90px;
  }

  /* Texto */
  .team-name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: #0D1F2D;
    line-height: 1.1;
    margin-bottom: 0.25rem;
  }

  .team-role {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #C9A84C;
    margin-bottom: 1.25rem;
  }

  .team-bio {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(26, 26, 26, 0.7);
    margin-bottom: 1.5rem;
  }

  .team-specialties {
    margin-bottom: 1.75rem;
  }

  .specialties-label {
    display: block;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(26, 26, 26, 0.4);
    margin-bottom: 0.625rem;
  }

  .specialties-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .specialty-tag {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    color: #0D1F2D;
    background: #F5F5F0;
    border: 1px solid #E8E8E0;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }

  .team-contact {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 0 1.5rem;
    margin: 0 0 0.5rem;
    border-top: 1px solid #E8E8E0;
    margin-top: 0.75rem;
    padding-top: 1rem;
  }

  .team-contact li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.875rem;
    color: rgba(26, 26, 26, 0.75);
  }

  .team-contact svg {
    color: #C9A84C;
    flex-shrink: 0;
  }

  .team-contact a {
    color: inherit;
    transition: color 0.2s ease;
    word-break: break-all;
  }

  .team-contact a:hover {
    color: #C9A84C;
  }

  .team-cta {
    display: inline-block;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
    background: #0D1F2D;
    padding: 0.8125rem 1.75rem;
    border-radius: 0;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .team-cta:hover {
    background: #C9A84C;
    color: #0D1F2D;
  }

  .team-notice {
    margin-top: 3rem;
    text-align: center;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    color: rgba(26, 26, 26, 0.35);
  }

  /* CTA final */
  .about-cta {
    background: #0D1F2D;
    padding: 5rem 0;
    text-align: center;
  }

  .about-cta-inner {
    max-width: 620px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .about-cta-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.75rem, 3.5vw, 2.375rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 0.875rem;
  }

  .about-cta-text {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .about-cta-btn {
    display: inline-block;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #0D1F2D;
    background: #C9A84C;
    padding: 0.9375rem 2.5rem;
    border-radius: 0;
    transition: background 0.2s ease;
  }

  .about-cta-btn:hover { background: #b8953e; }

  /* Responsive */
  @media (max-width: 820px) {
    .team-row,
    .team-row.reversed {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      max-width: 460px;
      margin-inline: auto;
    }
    .team-row .team-photo-col,
    .team-row .team-text-col,
    .team-row.reversed .team-photo-col,
    .team-row.reversed .team-text-col { order: initial; }
    .team-badge { right: 1rem; }
  }

  @media (max-width: 580px) {
    .about-hero { padding: 7rem 0 4rem; }
    .about-intro { padding: 4rem 0 1rem; }
    .team-section { padding: 2rem 0 4rem; }
    .about-cta { padding: 4rem 0; }
  }
</style>
