---
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Placeholder del equipo - Fase posterior: fetch desde Supabase
//   SELECT * FROM abogados WHERE activo = true AND deleted_at IS NULL ORDER BY orden
// Los datos reales se cargaran desde el panel de administracion.
type TeamMember = {
  nombre: string;
  cargo: Record<Lang, string>;
  bio: Record<Lang, string>;
  especialidades: Record<Lang, string[]>;
  anos: number;
  foto_url: string | null;
};

const team: TeamMember[] = [
  {
    nombre: 'Patricio Guíñez',
    cargo: { es: 'Socio Fundador', en: 'Founding Partner', zh: '创始合伙人' },
    bio: {
      es: 'Lidera el área de litigios laborales y civiles con un enfoque estratégico y orientado a resultados. Su experiencia en tribunales respalda cada defensa.',
      en: 'Leads the labour and civil litigation practice with a strategic, results-oriented approach. His courtroom experience backs every defense.',
      zh: '以战略性和结果导向的方式领导劳动和民事诉讼业务。他丰富的庭审经验为每一次辩护提供支持。',
    },
    especialidades: {
      es: ['Derecho Laboral', 'Derecho Civil'],
      en: ['Labour Law', 'Civil Law'],
      zh: ['劳动法', '民法'],
    },
    anos: 18,
    foto_url: null,
  },
  {
    nombre: 'Camila Galaz',
    cargo: { es: 'Socia', en: 'Partner', zh: '合伙人' },
    bio: {
      es: 'Especialista en derecho de familia y mediación, combina rigor jurídico con un trato cercano y humano en cada proceso.',
      en: 'A specialist in family law and mediation, she combines legal rigor with a close, human approach in every case.',
      zh: '家庭法和调解专家，在每个案件中将法律的严谨与亲切人性化的服务相结合。',
    },
    especialidades: {
      es: ['Derecho de Familia', 'Derecho Civil'],
      en: ['Family Law', 'Civil Law'],
      zh: ['家庭法', '民法'],
    },
    anos: 14,
    foto_url: null,
  },
  {
    nombre: 'Felipe Soto',
    cargo: { es: 'Abogado Asociado', en: 'Associate Attorney', zh: '助理律师' },
    bio: {
      es: 'Enfocado en defensa penal y asesoría corporativa, aporta una mirada actualizada del derecho y un fuerte compromiso con cada cliente.',
      en: 'Focused on criminal defense and corporate advice, he brings an up-to-date legal perspective and a strong commitment to every client.',
      zh: '专注于刑事辩护和公司咨询，带来与时俱进的法律视角和对每位客户的坚定承诺。',
    },
    especialidades: {
      es: ['Derecho Penal', 'Derecho Corporativo'],
      en: ['Criminal Law', 'Corporate Law'],
      zh: ['刑法', '公司法'],
    },
    anos: 8,
    foto_url: null,
  },
];

const getInitials = (nombre: string) =>
  nombre
    .split(' ')
    .map((w) => w.charAt(0))
    .slice(0, 2)
    .join('')
    .toUpperCase();

const avatarColors = ['#0D1F2D', '#C9A84C', '#6B7B8A'];

// Valores del estudio - iconos Lucide inline
const values = [
  {
    key: 'integridad',
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>`,
  },
  {
    key: 'excelencia',
    icon: `<circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>`,
  },
  {
    key: 'compromiso',
    icon: `<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/>`,
  },
  {
    key: 'cercania',
    icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  },
];
---

<!-- Hero interior -->
<section class="about-hero">
  <div class="about-hero-inner">
    <p class="about-hero-label">{t(lang, 'about.heroLabel')}</p>
    <h1 class="about-hero-title">{t(lang, 'about.heroTitle')}</h1>
    <p class="about-hero-subtitle">{t(lang, 'about.heroSubtitle')}</p>
  </div>
</section>

<!-- Intro -->
<section class="about-intro">
  <div class="about-intro-inner">
    <h2 class="about-intro-title">{t(lang, 'about.introTitle')}</h2>
    <p class="about-intro-body">{t(lang, 'about.introBody')}</p>
  </div>
</section>

<!-- Equipo -->
<section class="team-section">
  <div class="team-container">
    <div class="team-header">
      <h2 class="team-title">{t(lang, 'about.teamTitle')}</h2>
      <p class="team-subtitle">{t(lang, 'about.teamSubtitle')}</p>
    </div>

    <div class="team-grid">
      {team.map((member, i) => (
        <article class="team-card">
          <div class="team-photo-wrap">
            {member.foto_url
              ? <img src={member.foto_url} alt={member.nombre} class="team-photo" loading="lazy" />
              : (
                <div class="team-avatar" style={`background:${avatarColors[i] ?? '#0D1F2D'}`} aria-hidden="true">
                  {getInitials(member.nombre)}
                </div>
              )
            }
          </div>
          <h3 class="team-name">{member.nombre}</h3>
          <p class="team-role">{member.cargo[lang]}</p>
          <p class="team-bio">{member.bio[lang]}</p>
          <div class="team-specialties">
            <span class="specialties-label">{t(lang, 'about.specialtiesLabel')}</span>
            <ul class="specialties-list">
              {member.especialidades[lang].map((esp) => (
                <li class="specialty-tag">{esp}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <p class="team-notice">{t(lang, 'about.teamNotice')}</p>
  </div>
</section>

<!-- Valores -->
<section class="values-section">
  <div class="values-container">
    <div class="values-header">
      <h2 class="values-title">{t(lang, 'about.valuesTitle')}</h2>
      <p class="values-subtitle">{t(lang, 'about.valuesSubtitle')}</p>
    </div>

    <div class="values-grid">
      {values.map((value) => (
        <article class="value-card">
          <div class="value-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true" set:html={value.icon} />
          </div>
          <h3 class="value-name">{t(lang, `about.values.${value.key}.title`)}</h3>
          <p class="value-desc">{t(lang, `about.values.${value.key}.desc`)}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- CTA final -->
<section class="about-cta">
  <div class="about-cta-inner">
    <h2 class="about-cta-title">{t(lang, 'about.ctaTitle')}</h2>
    <p class="about-cta-text">{t(lang, 'about.ctaText')}</p>
    <a href={`/${lang}/contacto`} class="about-cta-btn">{t(lang, 'about.ctaButton')}</a>
  </div>
</section>

<style>
  /* Hero interior */
  .about-hero {
    background: #0D1F2D;
    padding: 9rem 0 5rem;
    text-align: center;
  }

  .about-hero-inner {
    max-width: 760px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .about-hero-label {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #C9A84C;
    margin-bottom: 1rem;
  }

  .about-hero-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .about-hero-subtitle {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.72);
  }

  /* Intro */
  .about-intro {
    background: #ffffff;
    padding: 5rem 0;
  }

  .about-intro-inner {
    max-width: 760px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    text-align: center;
  }

  .about-intro-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.75rem, 3.5vw, 2.375rem);
    font-weight: 700;
    color: #0D1F2D;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  .about-intro-body {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: rgba(26, 26, 26, 0.72);
  }

  /* Equipo */
  .team-section {
    background: #F5F5F0;
    padding: 6rem 0;
    border-top: 1px solid #E8E8E0;
  }

  .team-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .team-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .team-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: #0D1F2D;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .team-subtitle {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1rem;
    color: rgba(26, 26, 26, 0.6);
    max-width: 480px;
    margin-inline: auto;
    line-height: 1.6;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .team-card {
    background: #ffffff;
    border: 1px solid #E8E8E0;
    border-radius: 4px;
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: box-shadow 0.25s ease, transform 0.2s ease;
  }

  .team-card:hover {
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.09);
    transform: translateY(-2px);
  }

  .team-photo-wrap {
    width: 96px;
    height: 96px;
    margin-bottom: 1.25rem;
  }

  .team-photo {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
  }

  .team-avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 2rem;
    font-weight: 700;
    color: #ffffff;
  }

  .team-name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.375rem;
    font-weight: 700;
    color: #0D1F2D;
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .team-role {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #C9A84C;
    margin-bottom: 1rem;
  }

  .team-bio {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.875rem;
    line-height: 1.65;
    color: rgba(26, 26, 26, 0.65);
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .team-specialties {
    width: 100%;
    border-top: 1px solid #E8E8E0;
    padding-top: 1.25rem;
  }

  .specialties-label {
    display: block;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(26, 26, 26, 0.4);
    margin-bottom: 0.625rem;
  }

  .specialties-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    list-style: none;
  }

  .specialty-tag {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    color: #0D1F2D;
    background: #F5F5F0;
    border: 1px solid #E8E8E0;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }

  .team-notice {
    margin-top: 2.5rem;
    text-align: center;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    color: rgba(26, 26, 26, 0.35);
  }

  /* Valores */
  .values-section {
    background: #ffffff;
    padding: 6rem 0;
    border-top: 1px solid #E8E8E0;
  }

  .values-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .values-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .values-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: #0D1F2D;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .values-subtitle {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1rem;
    color: rgba(26, 26, 26, 0.6);
    max-width: 480px;
    margin-inline: auto;
    line-height: 1.6;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .value-card {
    text-align: center;
    padding: 1.5rem 1rem;
  }

  .value-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #F5F5F0;
    color: #C9A84C;
  }

  .value-name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #0D1F2D;
    margin-bottom: 0.5rem;
  }

  .value-desc {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(26, 26, 26, 0.62);
  }

  /* CTA final */
  .about-cta {
    background: #0D1F2D;
    padding: 5rem 0;
    text-align: center;
  }

  .about-cta-inner {
    max-width: 620px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .about-cta-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.75rem, 3.5vw, 2.375rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 0.875rem;
  }

  .about-cta-text {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .about-cta-btn {
    display: inline-block;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #0D1F2D;
    background: #C9A84C;
    padding: 0.9375rem 2.5rem;
    border-radius: 0;
    transition: background 0.2s ease;
  }

  .about-cta-btn:hover { background: #b8953e; }

  /* Responsive */
  @media (max-width: 900px) {
    .team-grid { grid-template-columns: repeat(2, 1fr); }
    .values-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 580px) {
    .about-hero { padding: 7rem 0 4rem; }
    .about-intro, .team-section, .values-section, .about-cta { padding: 4rem 0; }
    .team-grid { grid-template-columns: 1fr; }
    .values-grid { grid-template-columns: 1fr; }
  }
</style>
