---
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const areas = [
  {
    slug: 'laboral',
    key: 'laboral',
    icon: `<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>`,
  },
  {
    slug: 'civil',
    key: 'civil',
    icon: `<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>`,
  },
  {
    slug: 'penal',
    key: 'penal',
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
  },
  {
    slug: 'familia',
    key: 'familia',
    icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  },
  {
    slug: 'corporativo',
    key: 'corporativo',
    icon: `<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>`,
  },
  {
    slug: 'contratos',
    key: 'contratos',
    icon: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/>`,
  },
];
---

<div class="areas-page">
  <!-- Page header -->
  <section class="page-header">
    <div class="header-inner">
      <p class="header-label">{t(lang, 'areas.heroLabel')}</p>
      <h1 class="header-title">{t(lang, 'areas.heroTitle')}</h1>
      <p class="header-subtitle">{t(lang, 'areas.heroSubtitle')}</p>
    </div>
  </section>

  <!-- Areas grid -->
  <section class="grid-section">
    <div class="grid-container">
      <div class="areas-grid">
        {areas.map((area) => (
          <a href={`/${lang}/areas-practica/${area.slug}`} class="area-card">
            <div class="card-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={area.icon}
              />
            </div>
            <h2 class="card-title">{t(lang, `areas.${area.key}.title`)}</h2>
            <p class="card-desc">{t(lang, `areas.${area.key}.desc`)}</p>
            <span class="card-explore">{t(lang, 'areas.explore')}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</div>

<style>
  .areas-page {
    background: #F5F5F0;
    min-height: 100vh;
  }

  /* --- Page header --- */
  .page-header {
    padding: 9rem 1.5rem 5rem;
    text-align: center;
  }

  .header-inner {
    max-width: 640px;
    margin-inline: auto;
  }

  .header-label {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #C9A84C;
    margin-bottom: 1rem;
  }

  .header-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 3.25rem);
    font-weight: 700;
    color: #1A1A1A;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .header-subtitle {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.65;
    color: #6B6B6B;
    max-width: 560px;
    margin-inline: auto;
  }

  /* --- Grid section --- */
  .grid-section {
    padding: 0 1.5rem 5rem;
  }

  .grid-container {
    max-width: 1200px;
    margin-inline: auto;
  }

  .areas-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* --- Area card --- */
  .area-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #E8E8E0;
    border-left: 1px solid #E8E8E0;
    border-radius: 8px;
    padding: 32px;
    text-decoration: none;
    transition: box-shadow 0.25s ease, border-left 0.25s ease, transform 0.2s ease;
  }

  .area-card:hover {
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.10);
    border-left: 3px solid #C9A84C;
    transform: translateY(-2px);
  }

  .card-icon {
    color: #0D1F2D;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }

  .card-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.375rem;
    font-weight: 700;
    color: #1A1A1A;
    line-height: 1.2;
    margin-top: 16px;
  }

  .card-desc {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.875rem;
    color: #6B6B6B;
    line-height: 1.6;
    margin-top: 8px;
    flex: 1;
  }

  .card-explore {
    display: block;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #C9A84C;
    margin-top: 24px;
    transition: letter-spacing 0.2s ease;
  }

  .area-card:hover .card-explore {
    letter-spacing: 0.14em;
  }

  /* --- Responsive --- */
  @media (max-width: 960px) {
    .areas-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .page-header {
      padding: 7rem 1.25rem 3.5rem;
    }
    .grid-section {
      padding: 0 1.25rem 4rem;
    }
    .areas-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .area-card:hover {
      transform: none;
    }
  }
</style>
