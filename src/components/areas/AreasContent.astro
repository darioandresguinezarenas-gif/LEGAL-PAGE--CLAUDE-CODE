---
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Placeholder - Fase posterior: fetch desde Supabase
//   SELECT * FROM areas_practica WHERE activo = true AND deleted_at IS NULL ORDER BY orden
const areas = [
  {
    slug: 'laboral',
    key: 'laboral',
    icon: `<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>`,
  },
  {
    slug: 'civil',
    key: 'civil',
    icon: `<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>`,
  },
  {
    slug: 'penal',
    key: 'penal',
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
  },
  {
    slug: 'familia',
    key: 'familia',
    icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  },
  {
    slug: 'corporativo',
    key: 'corporativo',
    icon: `<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>`,
  },
  {
    slug: 'contratos',
    key: 'contratos',
    icon: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/>`,
  },
];
---

<!-- Hero interior -->
<section class="areas-hero">
  <div class="areas-hero-inner">
    <p class="areas-hero-label">{t(lang, 'areas.heroLabel')}</p>
    <h1 class="areas-hero-title">{t(lang, 'areas.heroTitle')}</h1>
    <p class="areas-hero-subtitle">{t(lang, 'areas.heroSubtitle')}</p>
  </div>
</section>

<!-- Grid de áreas -->
<section class="areas-section">
  <div class="areas-container">
    <div class="areas-grid">
      {areas.map((area) => (
        <article class="area-card">
          <div class="area-card-inner">
            <div class="area-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                stroke-linejoin="round" aria-hidden="true" set:html={area.icon} />
            </div>
            <h2 class="area-card-title">{t(lang, `areas.${area.key}.title`)}</h2>
            <p class="area-card-desc">{t(lang, `areas.${area.key}.desc`)}</p>
            <a href={`/${lang}/areas-practica/${area.slug}`} class="area-explore-link">
              {t(lang, 'areas.explore')}
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Hero interior */
  .areas-hero {
    background: #0D1F2D;
    padding: 9rem 0 5rem;
    text-align: center;
  }

  .areas-hero-inner {
    max-width: 760px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .areas-hero-label {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #C9A84C;
    margin-bottom: 1rem;
  }

  .areas-hero-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .areas-hero-subtitle {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.72);
  }

  /* Grid */
  .areas-section {
    background: #ffffff;
    padding: 5rem 0 6rem;
  }

  .areas-container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .areas-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .area-card {
    border: 1px solid #E8E8E0;
    background: #ffffff;
    transition: box-shadow 0.25s ease, border-left-color 0.25s ease, transform 0.2s ease;
  }

  .area-card:hover {
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.10);
    border-left: 3px solid #C9A84C;
    transform: translateY(-2px);
  }

  .area-card-inner {
    padding: 2rem 1.75rem;
  }

  .area-icon {
    width: 24px;
    height: 24px;
    color: #0D1F2D;
    margin-bottom: 1.25rem;
  }

  .area-card-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.3125rem;
    font-weight: 700;
    color: #0D1F2D;
    margin-bottom: 0.625rem;
    line-height: 1.2;
  }

  .area-card-desc {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.875rem;
    color: rgba(26, 26, 26, 0.65);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .area-explore-link {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #C9A84C;
    transition: letter-spacing 0.2s ease;
  }

  .area-explore-link:hover { letter-spacing: 0.12em; }

  /* Responsive */
  @media (max-width: 900px) {
    .areas-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 580px) {
    .areas-hero { padding: 7rem 0 4rem; }
    .areas-section { padding: 4rem 0; }
    .areas-grid { grid-template-columns: 1fr; }
    .area-card:hover { border-left: 3px solid #C9A84C; transform: none; }
  }
</style>
