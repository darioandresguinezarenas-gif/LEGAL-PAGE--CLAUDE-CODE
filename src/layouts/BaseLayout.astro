---
import SeoHead from '../components/shared/SeoHead.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
  lang: 'es' | 'en' | 'zh';
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Estudio jurídico en Rancagua. Derecho Laboral, Civil, Penal y Familia.',
  lang,
  ogImage,
  noindex = false,
} = Astro.props;

const langMap = { es: 'es-CL', en: 'en-US', zh: 'zh-CN' };
---
<!doctype html>
<html lang={langMap[lang]} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead
      title={title}
      description={description}
      lang={lang}
      ogImage={ogImage}
      noindex={noindex}
    />
  </head>
  <body>
    <Navbar lang={lang} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>
