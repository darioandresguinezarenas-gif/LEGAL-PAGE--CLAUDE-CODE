# Supabase — obtener en app.supabase.com > Settings > API
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo usar en Edge Functions con service_role — NUNCA en el frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend — obtener en resend.com
RESEND_API_KEY=re_...

# Transbank Webpay Plus
# Credenciales de integración (solo para desarrollo):
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
# Cambiar a 'production' una vez aprobada la certificación Transbank
TRANSBANK_ENV=integration

# Google Analytics 4
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Places API — para widget de reseñas en Home
# Obtener Place ID en: https://developers.google.com/maps/documentation/places/web-service/place-id
# Obtener API Key en: https://console.cloud.google.com (habilitar Places API)
# Dejar vacío hasta que el cliente tenga su Google Business Profile verificado
PUBLIC_GOOGLE_PLACE_ID=
PUBLIC_GOOGLE_PLACES_API_KEY=
